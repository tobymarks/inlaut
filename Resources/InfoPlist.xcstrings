  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "inlaut only listens while you use the shortcut. The recording is turned into text on this Mac and never leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "inlaut hört nur zu, solange du die Tastenkombination nutzt. Die Aufnahme wird auf diesem Mac in Text umgewandelt und verlässt ihn nicht."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "inlaut turns your speech into text on this Mac with the macOS speech recognition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "inlaut wandelt deine Sprache mit der Spracherkennung von macOS auf diesem Mac in Text um."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "inlaut"
          }
        }
      }
    }
  }
}