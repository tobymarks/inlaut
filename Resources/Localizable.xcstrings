    },
    "**Hold** to talk, release to paste. **Double-tap** for hands-free dictation, a single tap ends it. 🌐 together with another key keeps working as fn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Halten** zum Sprechen, loslassen fügt ein. **Zweimal tippen** zum freihändigen Diktieren, einmal tippen beendet. 🌐 zusammen mit einer anderen Taste bleibt normale fn-Nutzung."
          }
        }
      }
    },
    "Activate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren"
