{
  "sourceLanguage": "en",
  "strings": {
    "%@ is ready, %@ on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereit, %@ auf diesem Mac."
          }
        }
      }
    },
    "%@ is resting to free up memory and loads again with your next dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ruht, um Speicher freizugeben, und lädt beim nächsten Diktat neu."
          }
        }
      }
    },
    "%@, %@ on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ auf diesem Mac."
          }
        }
