// Static site for inlaut.de, served by Cloudflare Workers static assets.
// Deploy: npx wrangler deploy (from this directory)
{
  "name": "inlaut-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "inlaut.de", "custom_domain": true },
    { "pattern": "www.inlaut.de", "custom_domain": true }
  ]
}
